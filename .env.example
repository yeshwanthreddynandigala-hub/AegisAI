# Environment Configuration for AI Behavior Security & Threat Investigation System

# Database connection (SQLite default for zero-dependency local operation; PostgreSQL ready)
DATABASE_URL=sqlite:///./data/agent_sentinel.db

# LLM Investigation Provider (offline | gemini | openai)
LLM_PROVIDER=offline
LLM_API_KEY=
LLM_MODEL_NAME=mock-analyst-v1

# Debug / Telemetry settings
DEBUG=false
MAX_POLICY_DENIALS_BEFORE_LOCKOUT=3

# Security & Authentication (JWT & RBAC)
JWT_SECRET_KEY=generate-a-strong-random-secret-key-for-production!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_ADMIN_PASSWORD=AdminAegis2026!
DEFAULT_ANALYST_PASSWORD=AnalystAegis2026!
